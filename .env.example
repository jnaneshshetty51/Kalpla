# Copy to .env.local and fill in with values from your Supabase project
# (Project Settings > API): https://supabase.com/dashboard/project/_/settings/api-keys

# Project URL — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Anon/publishable key — safe to expose to the browser. Access is governed
# by Row Level Security policies, not by keeping this secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role/secret key — server-only, bypasses Row Level Security.
# Never expose to the browser or prefix with NEXT_PUBLIC_. Only required
# for admin-privileged server-side operations.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres superuser password — only needed for direct DB access (Supabase
# CLI db push/pull, or an ORM connecting directly). Not read by the app.
SUPABASE_DB_PASSWORD=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Only needed for LOCAL Google sign-in via `supabase start` — read by
# supabase/config.toml's [auth.external.google] block, not by the app
# directly. The hosted project's Google provider is configured separately in
# the Supabase Dashboard (Authentication > Providers > Google) and is
# unaffected by these. Redirect URI for the Google Cloud app should be
# http://127.0.0.1:54321/auth/v1/callback for local dev.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# OpenAI API Key — required for generating text embeddings & OpenAI LLM calls
OPENAI_API_KEY=

# Anthropic API Key — required for Claude models (Haiku, Sonnet)
ANTHROPIC_API_KEY=

# Default LLM provider choice ('anthropic' | 'openai')
DEFAULT_LLM_PROVIDER=anthropic

# Resend API key — required to actually send the daily coach nudge email.
# Without it, sends are logged to the console instead (dev fallback).
RESEND_API_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`
# when calling /api/cron/daily-coach. Required in production; without it
# the endpoint runs unauthenticated (dev only — a warning is logged).
CRON_SECRET=

# Stripe secret key (server-only) — required for checkout/portal/webhook.
STRIPE_SECRET_KEY=

# Signing secret for the /api/billing/webhook endpoint, from the Stripe
# dashboard's webhook config. Required — without it the webhook route
# refuses all events rather than trusting an unverified payload.
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for each paid tier (Stripe dashboard > Product catalog).
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=

# Absolute production origin (no trailing slash), e.g. https://kalpla.com —
# used by sitemap.ts, robots.ts, and JSON-LD, which render statically at
# build time with no incoming request to derive an origin from. Falls back
# to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=

# Daily.co API key (server-only) — required to create video rooms and mint
# per-user meeting tokens for embedded live sessions. Get one from the
# Daily dashboard (Developers > API Keys). Without it, admin session
# creation and joining a session both fail with a clear "not configured"
# error rather than a confusing one.
DAILY_API_KEY=

# Sentry error monitoring. Both unset is a safe no-op (see
# instrumentation.ts / instrumentation-client.ts / sentry.*.config.ts) —
# nothing is captured or sent anywhere until these are set. Get a DSN from
# a Sentry project's Settings > Client Keys.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
